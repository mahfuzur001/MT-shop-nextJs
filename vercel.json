{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "env": {
    "NEXT_PUBLIC_API_BASE_URL": {
      "description": "Backend API base URL (must be NEXT_PUBLIC to be exposed to client)",
      "required": true
    }
  },
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
